{
  "name": "jemo-theme",
  "displayName": "Jemo Theme",
  "description": "A dark VS Code theme generated from the Jemo palette.",
  "version": "0.0.4",
  "icon": "images/icon.png",
  "publisher": "jemo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jemo69/jemo-vscode-theme.git"
  },
  "bugs": {
    "url": "https://github.com/Jemo69/jemo-vscode-theme/issues"
  },
  "homepage": "https://github.com/Jemo69/jemo-vscode-theme#readme",
  "keywords": [
    "theme",
    "dark theme",
    "color theme",
    "jemo"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Jemo",
        "uiTheme": "vs-dark",
        "path": "./themes/Jemo-color-theme.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "latest"
  }
}
